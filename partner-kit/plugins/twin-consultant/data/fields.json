{
  "catalogue_version": 1,
  "about": "Field catalogue for the customer profile and the persona card. Design: partner-kit/docs/design.md, section 5. A default is {value, source}; source is the compendium or playbook page that sets it. required is true when a levelling decision (design section 7) or the persona voice needs the field. key is true for a field that names or links an entry (record ids, list keys, references): a key field is always structurally required, carries no provenance and is left out of completeness, so its required flag is false. Lists whose key is null are positional: their paths use the position, as in tasks.T1.writes[0].action.",
  "envelope": {
    "profile": [
      "profile_version",
      "provenance"
    ],
    "card": [
      "card_version",
      "provenance"
    ]
  },
  "record_versions": {
    "profile": 1,
    "card": 1
  },
  "keys": {
    "profile": {
      "systems": "id"
    },
    "card": {
      "outcome.scorecard_targets": "metric",
      "features": "id",
      "tasks": "id",
      "tasks[].inputs": null,
      "tasks[].writes": null,
      "overrides": null,
      "open_questions": "id"
    }
  },
  "duplicates_warn": {
    "card": {
      "tasks[].inputs": [
        "system",
        "objects",
        "access"
      ],
      "tasks[].writes": [
        "system",
        "objects",
        "action"
      ]
    }
  },
  "provenance": {
    "statuses": [
      "answered",
      "default",
      "assumed",
      "open"
    ],
    "counts_as_complete": [
      "answered",
      "default"
    ],
    "needs_owner": [
      "assumed",
      "open"
    ],
    "needs_due": [
      "open"
    ],
    "may_be_empty": [
      "open"
    ]
  },
  "references": {
    "card": [
      {
        "path": "tasks[].feature",
        "must_be": "features[].id"
      },
      {
        "path": "tasks[].inputs[].system",
        "must_be": "profile:systems[].id"
      },
      {
        "path": "tasks[].writes[].system",
        "must_be": "profile:systems[].id"
      },
      {
        "path": "overrides[].task",
        "must_be": "tasks[].id"
      },
      {
        "path": "open_questions[].blocks",
        "must_be": "tasks[].id"
      }
    ]
  },
