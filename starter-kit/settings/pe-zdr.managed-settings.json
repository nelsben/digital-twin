{
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "REPLACE-WITH-GITHUB-ORG/digital-twin-kit"
    }
  ],
  "forceLoginOrgUUID": "REPLACE-WITH-ORG-UUID",
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverUrl": "https://REPLACE-WITH-SALESFORCE-HOSTED-MCP-HOST/*" },
    { "serverUrl": "https://REPLACE-WITH-MICROSOFT-365-MCP-HOST/*" }
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
