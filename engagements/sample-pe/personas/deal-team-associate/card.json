{
  "card_version": 1,
  "id": "deal-team-associate",
  "customer": "example-capital-partners",
  "role": {
    "name": "Deal-team associate",
    "team": "Deal team",
    "headcount": 18,
    "pilot_users": 6,
    "works_in": [
      "claude-code"
    ],
    "device": "managed",
    "plugin_name": "twin-pe-deal-team"
  },
  "outcome": {
    "sponsor_goal": "In 6 months the deal team spends visibly less time on first-pass company briefs and CRM upkeep, with a low edit rate on what the twin drafts.",
    "scorecard_targets": []
  },
  "voice": {
    "serves": "The deal team: the principal on each deal first, then the partners; the associates a principal reviews; and, through the memos, the investment committee.",
    "jobs": [
      "Draft one-page company briefs",
      "Draft CRM updates after meetings",
      "Screen inbound CIMs and teasers",
      "Prepare call briefings",
      "Draft investment committee memo sections"
    ],
    "tone": "Plain, terse and factual, like a careful associate: every figure has its source, and nothing is hedged without a reason.",
    "norms": [
      "Cite the Salesforce record or SharePoint file behind every fact",
      "Say what is missing rather than fill a gap",
      "Use the firm's one-page brief format"
    ],
    "never": [
      "Use web search or fetch on a live deal",
      "Bring investor-relations or fundraising data into deal work",
      "Send anything outside the firm",
      "Read or summarise portfolio-company health files until compliance has ruled on PHI"
    ],
    "ask_before": [
      "Changing any Salesforce field",
      "Posting anything to a Teams channel"
    ],
    "escalate_to": [
      "The principal on the deal",
      "The Chief Compliance Officer for any wall or MNPI question"
    ]
  },
  "features": [
    {
      "id": "pre-meeting-preparation",
      "name": "Pre-meeting preparation",
      "why": "Briefs and call notes are the largest share of an associate's week."
    },
    {
      "id": "pipeline-upkeep-and-reporting",
      "name": "Pipeline upkeep and reporting",
      "why": "CRM upkeep is half of the sponsor's 6-month outcome."
    },
    {
      "id": "deal-screening",
      "name": "Deal screening",
      "why": "Inbound CIMs arrive every week and a missed red flag is costly."
    },
    {
      "id": "investment-committee-drafting",
      "name": "Investment committee drafting",
      "why": "Memo sections take a full afternoon each."
    }
  ],
  "tasks": [
    {
      "id": "T1",
      "feature": "pre-meeting-preparation",
      "name": "Prepare a one-page company brief",
      "frequency_per_week": 4,
      "minutes_each": 90,
      "users": 3,
      "trigger": "person",
      "inputs": [
        {
          "system": "salesforce",
          "objects": "deal record (opportunity, account)",
          "access": "read"
        },
        {
          "system": "sharepoint",
          "objects": "prior memos and data-room files",
          "access": "read"
        }
      ],
      "output": {
        "what": "One-page company brief",
        "audience": "internal",
        "destination": "none (the conversation)"
      },
      "writes": [],
      "data_class": "highly-sensitive",
      "cost_of_mistake": {
        "level": "medium",
        "what_happens": "A wrong fact can reach a partner discussion. A reviewer checks every brief."
      },
      "constraints": [
        "A reviewer checks every brief before it goes further."
      ],
      "reversible": true,
      "touches_money": false,
      "reads_untrusted_input": true,
      "examples": {
        "good": null,
        "bad": null,
        "where": ""
      },
      "skill_owner": "Callum Nwosu",
      "priority": 1,
      "in_pilot": true
    },
    {
      "id": "T2",
      "feature": "pipeline-upkeep-and-reporting",
      "name": "Update the CRM after a meeting",
      "frequency_per_week": 10,
      "minutes_each": 15,
      "users": 18,
      "trigger": "person",
      "inputs": [
        {
          "system": "teams",
          "objects": "meeting notes or transcript",
          "access": "read"
        },
        {
          "system": "salesforce",
          "objects": "opportunity",
          "access": "read"
        }
      ],
      "output": {
        "what": "Activity log and next-step fields",
        "audience": "internal",
        "destination": "Salesforce opportunity"
      },
      "writes": [
        {
          "system": "salesforce",
          "objects": "opportunity activity log and next-step fields",
          "action": "update"
        }
      ],
      "data_class": "highly-sensitive",
      "cost_of_mistake": {
        "level": "medium",
        "what_happens": "Stale or wrong pipeline data (low to medium). Writes start as drafts a person approves."
      },
      "constraints": [
        "I want to approve each change before it's written."
      ],
      "wanted_change": "Later it could start when the meeting ends.",
      "reversible": true,
      "touches_money": false,
      "reads_untrusted_input": false,
      "examples": {
        "good": null,
