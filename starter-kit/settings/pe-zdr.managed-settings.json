{
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "REPLACE-WITH-GITHUB-ORG/digital-twin-kit"
    }
  ],
  "extraKnownMarketplaces": {
    "digital-twin-kit": {
      "source": {
        "source": "github",
        "repo": "REPLACE-WITH-GITHUB-ORG/digital-twin-kit"
      }
    }
  },
  "enabledPlugins": {
    "twin-shared@digital-twin-kit": true,
    "twin-governance@digital-twin-kit": true
  },
  "env": {
    "TWIN_GOVERNANCE_ORG_LABEL": "pe-zdr",
    "TWIN_GOVERNANCE_SALT": "REPLACE-WITH-GOVERNANCE-SALT"
  },
  "forceLoginOrgUUID": "REPLACE-WITH-ORG-UUID",
  "forceLoginMethod": "claudeai",
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverUrl": "https://REPLACE-WITH-SALESFORCE-HOSTED-MCP-HOST/*" },
    { "serverUrl": "https://REPLACE-WITH-MICROSOFT-365-MCP-HOST/*" }
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
